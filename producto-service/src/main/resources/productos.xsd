<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://unibague.edu.co/productos"
           targetNamespace="http://unibague.edu.co/productos"
           elementFormDefault="qualified">

    <xs:element name="getProductoRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="id" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="getProductoResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="producto" type="tns:producto"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!--
        Evolucion Taller 02 v2.0: el precio monetario usa xs:decimal (exacto)
        en lugar de xs:double (punto flotante binario). El formato del mensaje
        en el wire es el mismo numero, por lo que los clientes SOAP existentes
        siguen interoperando.
    -->
    <xs:complexType name="producto">
        <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="nombre" type="xs:string"/>
            <xs:element name="precio" type="xs:decimal"/>
            <xs:element name="stock" type="xs:int"/>
        </xs:sequence>
    </xs:complexType>
</xs:schema>
